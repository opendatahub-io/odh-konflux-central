# Dockerfile for self-hosted GitHub Actions runner container.
#
# Build:
#   docker build -f Dockerfile.github-runner \
#     --build-arg RUNNER_VERSION=2.334.0 \
#     -t github-runner:2.334.0 .
#
# Ubuntu 22.04 is used because the runner's installdependencies.sh
# requires apt and Debian/Ubuntu packages.

FROM ubuntu:26.04

ARG RUNNER_VERSION=2.334.0

ENV DEBIAN_FRONTEND=noninteractive
ENV RUNNER_ALLOW_RUNASROOT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      sudo \
      unzip \
      zip \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash --uid 1001 runner \
    && echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/runner

WORKDIR /home/runner/actions-runner

RUN curl -fsSL \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" \
      -o runner.tar.gz \
    && tar xzf runner.tar.gz \
    && rm runner.tar.gz \
    && ./bin/installdependencies.sh \
    && chown -R runner:runner /home/runner

COPY setup-runner-prerequisites.sh /tmp/setup-runner-prerequisites.sh
RUN chmod +x /tmp/setup-runner-prerequisites.sh \
    && /tmp/setup-runner-prerequisites.sh \
    && rm /tmp/setup-runner-prerequisites.sh

COPY runner-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh && chown runner:runner ./entrypoint.sh

USER runner
ENTRYPOINT ["./entrypoint.sh"]
