{
  "schemaVersion": 1,
  "smokeComponents": {
    "dashboard_cypress": {
      "keys": [
        "dashboard",
        "modelregistry",
        "workbenches",
        "kserve",
        "aipipelines",
        "feastoperator"
      ]
    },
    "workbenches": {"keys": ["dashboard", "workbenches"], "pre35ExtraKeys": ["trainingoperator"]},
    "model_registry": {"keys": ["modelregistry"]},
    "model_server": {"keys": ["kserve"]},
    "model_runtime": {"keys": ["kserve"]},
    "maas_billing": {"keys": ["kserve"]},
    "ai_safety": {"keys": ["trustyai", "kserve"]},
    "ai_safety_evalhub": {"keys": ["trustyai", "kserve"]},
    "ai_safety_guardrails": {"keys": ["trustyai", "kserve"]},
    "ai_safety_lmeval": {"keys": ["trustyai", "kserve"]},
    "ai_safety_trustyai_operator": {"keys": ["trustyai", "kserve"]},
    "ai_safety_trustyai_service": {"keys": ["trustyai", "kserve"]},
    "ai_pipelines": {"keys": ["aipipelines"]},
    "kuberay": {"keys": ["ray"]},
    "mlflow": {"keys": ["mlflowoperator"]},
    "llama_stack": {"keys": ["llamastackoperator"]},
    "ogx": {"keys": ["ogx"]},
    "trainer": {"keys": ["trainer"], "pre35ExtraKeys": ["trainingoperator"]},
    "distributed_workloads": {"keys": ["ray", "trainer"], "pre35ExtraKeys": ["trainingoperator"]},
    "spark_operator": {"keys": ["sparkoperator"]},
    "codeflare_sdk": {"keys": ["ray", "codeflare"]}
  },
  "installPolicy": {
    "versionBands": [
      {
        "minRhoai": "3.5",
        "installRemoved": ["llamastackoperator", "ogx", "sparkoperator", "trainingoperator"]
      }
    ]
  }
}
